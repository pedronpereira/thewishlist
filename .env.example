# Copy to .env and fill in what you need. Loaded automatically by
# `air` / `go run cmd/main.go`. .env is gitignored — never commit real values.

PORT=

# HTTP Basic Auth. Leave blank for open, unauthenticated access.
WISHLIST_USERNAME=
WISHLIST_PASSWORD=

# A second Basic Auth login with elevated request-level access.
# Only reachable if WISHLIST_PASSWORD above is also set.
WISHLIST_ADMIN_USERNAME=
WISHLIST_ADMIN_PASSWORD=

# Set STORE_TYPE=postgres to use Postgres instead of the local JSON file store.
STORE_TYPE=
DATABASE_URL=
